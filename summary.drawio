        <mxCell id="valTags" value="value family: { ValSSA | ValScalar | ValPtr | ValStruct | ValMemref | ValBuffer | ValSOA | ValMdspan }" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=13;fontColor=#35639a" vertex="1" parent="1">
