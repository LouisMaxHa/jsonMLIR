        <mxCell id="opRoot" value="&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;Codegen&lt;/div&gt;&lt;div style=&quot;color:#8a5a00;font-size:14px&quot;&gt;abstract operation / JSON AST node&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;inherits&lt;/b&gt; BaseModel + ABC&lt;br&gt;&lt;b&gt;attrs&lt;/b&gt; op: Literal[...] discriminator&lt;br&gt;model_config: arbitrary_types_allowed&lt;br&gt;&lt;b&gt;interface&lt;/b&gt; codegen() -&amp;gt; Sequence[ValNode]&lt;br&gt;__repr__() -&amp;gt; class name&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#3f3f46;spacing=12;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="520" height="215" as="geometry" />
        </mxCell>
        <mxCell id="valRoot" value="&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;ValNode[T]&lt;/div&gt;&lt;div style=&quot;color:#35639a;font-size:14px&quot;&gt;abstract runtime value wrapper&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;attrs&lt;/b&gt; ty: T, usually addr: mlir.ir.Value&lt;br&gt;&lt;b&gt;interface&lt;/b&gt; init_from(type, source)&lt;br&gt;get_ty(), get_type(), get_dim()&lt;br&gt;get_SSA() -&amp;gt; MLIR Value&lt;br&gt;load(index) / store(index, source)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;spacing=12;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="640" y="125" width="520" height="215" as="geometry" />
        </mxCell>
        <mxCell id="tyRoot" value="&lt;div style=&quot;font-size:22px;font-weight:bold&quot;&gt;TyNode&lt;/div&gt;&lt;div style=&quot;color:#3e7544;font-size:14px&quot;&gt;frozen type descriptor / schema node&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;inherits&lt;/b&gt; BaseModel + ABC&lt;br&gt;&lt;b&gt;attrs&lt;/b&gt; type: discriminator, nested base/dims&lt;br&gt;frozen + populate_by_name&lt;br&gt;&lt;b&gt;interface&lt;/b&gt; get_type() -&amp;gt; MLIR Type&lt;br&gt;get_memref_type() -&amp;gt; MemRefType&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#274e2b;spacing=12;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1230" y="125" width="520" height="215" as="geometry" />
        </mxCell>

        <mxCell id="opTags" value="op tag space: { module | defineStruct | defineFunction | function | if | while | const | var | set | alloc | alloca | binary | unary | math | call | print | comment | notSupported }" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#8a5a00" vertex="1" parent="1">
          <mxGeometry x="55" y="352" width="510" height="28" as="geometry" />
