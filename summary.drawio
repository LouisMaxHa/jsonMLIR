        <mxCell id="title" value="jsonMLIR: the three-layer model" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#1f2937" vertex="1" parent="1">
