        <mxCell id="tyGroup2" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;shaped / layout&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;TyMemref: dims + base&lt;br&gt;TyBuffer: dims + struct base&lt;br&gt;TySOA: dims + struct base&lt;br&gt;TyMdspan: dims + base + index_type&lt;br&gt;&lt;span style=&quot;color:#3e7544&quot;&gt;all lower through type interface&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
