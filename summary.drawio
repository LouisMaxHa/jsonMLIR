        <mxCell id="subtitle" value="Operations describe intent  |  Values carry runtime state  |  Types describe representation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#667085" vertex="1" parent="1">
