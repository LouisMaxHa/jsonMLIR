        <mxCell id="tyContract" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;type contract&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;parse_ty(value) normalizes shorthand&lt;br&gt;&quot;i64&quot; -&amp;gt; TyScalar&lt;br&gt;{addr: ...} -&amp;gt; TyPtr&lt;br&gt;{memref: [...]} -&amp;gt; TyMemref&lt;br&gt;&lt;span style=&quot;color:#3e7544&quot;&gt;type shape controls value factory&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
