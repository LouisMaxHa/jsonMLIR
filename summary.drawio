        <mxCell id="valGroup2" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;shaped / aggregate&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;ValMemref&lt;br&gt;ValBuffer&lt;br&gt;ValSOA&lt;br&gt;ValMdspan&lt;br&gt;&lt;span style=&quot;color:#35639a&quot;&gt;indexing delegates through load/store&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="910" y="390" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="valContract" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;value contract&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;load(index) -&amp;gt; ValNode&lt;br&gt;store(index, source) -&amp;gt; None&lt;br&gt;get_SSA(index) resolves / loads&lt;br&gt;auto_log wraps _load / _store&lt;br&gt;&lt;span style=&quot;color:#35639a&quot;&gt;generic T is the bridge to TyNode&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="640" y="610" width="520" height="190" as="geometry" />
        </mxCell>

        <mxCell id="tyGroup1" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;atomic / identity&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;TyScalar: scalar / name&lt;br&gt;TyPtr: base&lt;br&gt;TyStruct: name / registry lookup&lt;br&gt;TySSA: runtime-known MLIR type&lt;br&gt;TyNotSupported: fallback / error&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1230" y="390" width="250" height="190" as="geometry" />
