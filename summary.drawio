        <mxCell id="opGroup1" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;container + control&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;ModuleJsonOp&lt;br&gt;DefineStructOp&lt;br&gt;DefineFunctionOp&lt;br&gt;FunctionOp&lt;br&gt;IfOp&lt;br&gt;WhileOp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="opGroup2" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;data + memory&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;ConstOp&lt;br&gt;VarOp&lt;br&gt;SetOp&lt;br&gt;AllocOp&lt;br&gt;AllocaOp&lt;br&gt;CallOp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="315" y="390" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="opGroup3" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;compute + utility&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;BinaryOp&lt;br&gt;UnaryOp&lt;br&gt;MathOp&lt;br&gt;PrintOp&lt;br&gt;CommentOp&lt;br&gt;NotSupportedOp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="50" y="610" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="opGroup4" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;recursive composition&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;JsonOp = discriminated union&lt;br&gt;Binary(lhs, rhs)&lt;br&gt;Set(var, val)&lt;br&gt;While(cond, thenBlock)&lt;br&gt;Module(body)&lt;br&gt;&lt;span style=&quot;color:#8a5a00&quot;&gt;ops contain other ops&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="315" y="610" width="250" height="190" as="geometry" />
        </mxCell>

        <mxCell id="valGroup1" value="&lt;div style=&quot;font-weight:bold;font-size:16px&quot;&gt;direct / scalar-like&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;ValSSA&lt;br&gt;ValScalar&lt;br&gt;ValPtr&lt;br&gt;ValStruct&lt;br&gt;&lt;span style=&quot;color:#35639a&quot;&gt;each binds one Ty* + an MLIR address/value&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="640" y="390" width="250" height="190" as="geometry" />
